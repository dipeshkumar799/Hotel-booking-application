<% layout("layouts/boilerplate") %>
<div class="row mt-10">
    <% for(let list of allList) { %>

        <div class="col-md-4 m mb-4">
            <div class="card" style="width: 20rem;">

                <img
                    src="<%= list.image.url %>"
                    class="card-img-top"
                    style="height: 20rem;"
                    alt="<%= list.title %>"

                >

                <div class="card-body">
                    <h5 class="card-title">
                        <%= list.title %>
                    </h5>

                    <p class="card-text">
                        &#8377;<%= list.price %>/night
                    </p>

                    <a href="/listings/<%= list._id %>" class="btn btn-primary">
                        View Listing
                    </a>
                </div>

            </div>
        </div>

    <% } %>
</div>
