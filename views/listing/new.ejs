
<% layout("layouts/boilerplate") %>

<h1>new data...........</h1>

<form method="POST"
      action="/listings/new"
      class="needs-validation"
      novalidate
      enctype="multipart/form-data">

    <label for="title" class="text-dark">Title:</label>
    <input
        type="text"
        id="title"
        placeholder="enter the title"
        name="title"
        class="form-control"
        required
    >
    <div class="invalid-feedback text-dark">
        Please enter the title.
    </div>

    <br><br>

    <label for="image-url" class="text-dark">Image:</label>
    <input
        type="text"
        id="image-url"
        name="image[url]"
        placeholder="image URL"
        class="form-control"
    >

    <br>

    <label for="image" class="text-dark">Upload your image:</label>
    <input
        type="file"
        id="image"
        name="image[url]"
        class="form-control"
        accept="image/*"
        required
    >
    <div class="invalid-feedback">
        Please upload an image.
    </div>

    <label for="description" class="text-dark">Description:</label>
    <textarea
        id="description"
        name="description"
        rows="4"
        class="form-control"
        required
    ></textarea>

    <div class="invalid-feedback">
        Please enter the description.
    </div>

    <br>

    <label for="location" class="text-dark">Location:</label>
    <input
        type="text"
        id="location"
        placeholder="enter the location"
        name="location"
        class="form-control"
        required
    >
    <div class="invalid-feedback">
        Please enter the location.
    </div>

    <br>

    <label for="country" class="text-dark">Country:</label>
    <input
        type="text"
        id="country"
        placeholder="enter the country"
        name="country"
        class="form-control"
        required
    >
    <div class="invalid-feedback">
        Please enter the country.
    </div>

    <br>

    <label for="price" class="text-dark">Price:</label>
    <input
        type="text"
        id="price"
        placeholder="enter the price"
        name="price"
        class="form-control"
        required
    >
    <div class="invalid-feedback">
        Please enter the price.
    </div>

    <br>

    <button type="submit" class="btn btn-primary">
        Submit
    </button>

</form>
